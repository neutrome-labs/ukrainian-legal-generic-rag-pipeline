# Environment variables for Ukrainian Legal RAG Pipeline
# Copy to .env and fill in your values

# ==========================================
# Cloudflare R2 Configuration
# ==========================================

# R2 endpoint URL (format: https://<account_id>.r2.cloudflarestorage.com)
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# R2 Access credentials (generate from Cloudflare dashboard)
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key

# Bucket name for storing legal documents
R2_BUCKET_NAME=ukrainian-legal-docs

# ==========================================
# Rada API Configuration (Optional)
# ==========================================

# API token for JSON requests (optional, get from https://data.rada.gov.ua/api/token)
# If not set, will use "OpenData" user agent which has limited JSON access
RADA_API_TOKEN=

# ==========================================
# Pipeline Settings
# ==========================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Local output directory (for testing without R2)
OUTPUT_DIR=./output

# Cache directory for API responses
CACHE_DIR=./cache
